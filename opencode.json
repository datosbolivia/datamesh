{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "git force-push*": "deny",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git clean -fdx*": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "ask",
      "chmod -R 777*": "deny",
      "chmod 777*": "deny"
    },
    "edit": {
      "*": "allow",
      "LICENSE": "deny",
      "**/LICENSE": "deny"
    }
  }
}